# Optional locally; set a stable origin before printing permanent QR codes.
# SITE_URL=https://your-domain.example
# Vercel preview deployments otherwise use VERCEL_URL; production uses VERCEL_PROJECT_PRODUCTION_URL.

# Admin stays locked if either value is absent or too short.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional. These are SERVER-ONLY values. Never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANALYTICS_ENABLED=false

NEXT_TELEMETRY_DISABLED=1
